local function CheckObject(obj)
    if not obj or not obj.Parent then return end
    local name = string.lower(obj.Name)
    if string.match(name, "generator") or name == "gen" then 
        if not table.find(trackedGenerators, obj) then table.insert(trackedGenerators, obj) end
    elseif string.match(name, "pallet") then 
        if obj:IsA("Model") or obj:IsA("BasePart") then if not table.find(trackedPallets, obj) then table.insert(trackedPallets, obj) end end
    elseif string.match(name, "hook") then 
        if not table.find(trackedHooks, obj) then table.insert(trackedHooks, obj) end
    elseif string.match(name, "gate") or string.match(name, "exit") then
        if not table.find(trackedGates, obj) then table.insert(trackedGates, obj) end
    end
end

