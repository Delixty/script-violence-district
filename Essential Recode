local function RefreshHUDVisibility()
    if not hudContainer then return end
    hudContainer.Visible = Settings.HUDEnabled hudFPS.Visible = Settings.HUDFPS hudPing.Visible = Settings.HUDPing hudKiller.Visible = Settings.HUDKiller
